{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reef",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "reef.cobular.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Logs never include request headers or bodies (see DESIGN.md, "What the operator can see").
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SIGNUP_MODE": "invite",
    "PUBLIC_ORIGIN": "https://reef.cobular.com"
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "reef-files" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reef",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }]
  // Secrets (wrangler secret put): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, TOKEN_SIGNING_KEY, COOKIE_SECRET
}
