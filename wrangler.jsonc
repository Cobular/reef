{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reef",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // global_fetch_strictly_public: required by workers-oauth-provider for Client ID Metadata
  // Documents, so a client-supplied metadata URL can never reach internal addresses.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Smaller bundle, faster cold starts. keep_names stays at its default (true), so class and
  // function names survive minification.
  "minify": true,
  // zod re-exports every translated locale as z.locales; Reef only uses English, which zod
  // imports separately. The key is the exact specifier zod's classic/core/mini entry points use
  // (no other bundled package imports it); the stub explains the rest.
  "alias": { "../locales/index.js": "./src/lib/zod-locales-stub.ts" },
  "routes": [{ "pattern": "reef.cobular.com", "custom_domain": true }],
  // Logs never include request headers or bodies (see DESIGN.md, "What the operator can see").
  // Invocation logs are off because they record request metadata; the worker emits its own
  // structured events via src/lib-log.ts, which drops anything key-, token- or header-shaped.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SIGNUP_MODE": "invite",
    "PUBLIC_ORIGIN": "https://reef.cobular.com",
    // GitHub logins (comma-separated, case-insensitive) that can open /admin.
    "ADMINS": "Cobular"
    // MAINTENANCE is not set here: the security-gate workflow deploys with --var MAINTENANCE:1,
    // and any normal deploy removes it again.
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "reef-files" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reef",
      "database_id": "0c3aeb8d-9236-419e-8ef9-426057fa1595",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "2f2f246f111e48a699e356b7f800f0ad" }],
  // Request rate limits (src/config.ts RATE_LIMITS holds the same numbers; a test compares them).
  // Per key per Cloudflare location, approximate. namespace_id must be unique in the account.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "7301", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_BEARER", "namespace_id": "7306", "simple": { "limit": 3000, "period": 60 } },
    { "name": "RL_ACCOUNT", "namespace_id": "7307", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "7302", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_MCP", "namespace_id": "7303", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "7304", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_DATA", "namespace_id": "7305", "simple": { "limit": 200, "period": 60 } }
  ]
  // Secrets (wrangler secret put): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, TOKEN_SIGNING_KEY, COOKIE_SECRET
  // Their types are declared in src/env.d.ts so typegen output does not depend on a local .dev.vars.
}
